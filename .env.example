# Copy to .env.local. NEVER commit real values.

# Gemini API key from https://aistudio.google.com/apikey (free tier, rate-limited).
# Note: Google AI Pro (the chat subscription) is separate from API billing (verify).
# Leave empty to use the mock provider.
GEMINI_API_KEY=
# Flash-class model for ASR + repair + summary. Model names change fast (verify).
# GEMINI_MODEL=gemini-3.5-flash-lite  (default ladder starts here)
# Tried in order on 503 "high demand" (comma-separated).
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-flash-latest,gemini-3.5-flash

# Database: local SQLite file by default; on Vercel use Turso (libsql://...) + token.
DATABASE_URL=file:./data/local.db
DATABASE_AUTH_TOKEN=

# Vercel Blob (created in Vercel dashboard -> Storage -> Blob; auto-injected on Vercel).
# Without it, client uploads are disabled and artifacts go to ./data/artifacts.
BLOB_READ_WRITE_TOKEN=

# Auth stub: shared bearer token for API calls. Empty = auth disabled (local dev only!).
API_TOKEN=

# Delete raw audio (segments + legacy audioUrl) once a job reaches "done" — free Blob hygiene. "false" to keep.
DELETE_RAW_AUDIO=true
# Android only polls GET /v1/jobs/{id}; each poll runs one pipeline stage. "false" if a cron/worker advances jobs.
AUTO_ADVANCE_ON_POLL=true
# Study PDF: headless Chrome via puppeteer-core (auto-detects /usr/bin/google-chrome|chromium). PDF_RENDERER=html → HTML only.
CHROME_PATH=
PDF_RENDERER=
